.f-users-email-login-waiting.container-fluid data=data
  h1 = t('folio.users.email_login.waiting_title')
  p = t('folio.users.email_login.sent_to', email: @email)
  p = instruction
  .f-users-email-login-waiting__progress
    span.f-users-email-login-waiting__spinner[
      aria-hidden="true"
      hidden=true
      data=spinner_data
    ]
      span.folio-loader.folio-loader--tiny.folio-loader--transparent
    p[
      role="status"
      aria-live="polite"
      data=status_data
    ]
      = message

  button[
    type="button"
    class="btn btn-primary mb-3"
    hidden=true
    data=continue_data
  ]
    = t('folio.users.email_login.continue')

  = form_tag controller.main_app.complete_user_email_login_path, method: :post, data: completion_form_data, authenticity_token: helpers.form_authenticity_token do
    .f-users-email-login-waiting__code
      label.form-label for=self.class::CODE_INPUT_ID = t('folio.users.email_login.code_label')
      .f-users-email-login-waiting__code-row
        input[
          type="text"
          id=self.class::CODE_INPUT_ID
          name="email_login_code"
          class=(@code_error ? "form-control is-invalid" : "form-control")
          inputmode="numeric"
          autocomplete="one-time-code"
          autocapitalize="off"
          autocorrect="off"
          spellcheck="false"
          disabled=!waiting?
          autofocus=(@code_error.present? && waiting?)
          aria=code_input_aria
          data=code_input_data
        ]
        = submit_tag t('folio.users.email_login.code_submit'),
                     formaction: controller.main_app.verify_code_user_email_login_path,
                     class: 'btn btn-primary',
                     disabled: !waiting?,
                     data: code_submit_data
      .invalid-feedback.d-block[
        id=self.class::CODE_ERROR_ID
        role="alert"
        hidden=@code_error.blank?
        data=code_error_data
      ]
        = @code_error
      small.form-text.d-block id=self.class::CODE_HINT_ID = t('folio.users.email_login.code_hint')

    .form-check.mb-3
      = hidden_field_tag :trust_browser, '0'
      = check_box_tag :trust_browser, '1', @trust_browser, class: 'form-check-input', id: 'email-login-trust-browser', data: trust_browser_data
      = label_tag 'email-login-trust-browser', t('folio.users.email_login.trust_browser'), class: 'form-check-label'
      small.d-block = t('folio.users.email_login.trust_explanation')
    = submit_tag t('folio.users.email_login.check'), class: 'btn btn-primary', disabled: !waiting?, data: stimulus_target('check')

    .f-users-email-login-waiting__resend
      = submit_tag t('folio.users.email_login.resend'), formaction: controller.main_app.resend_user_email_login_path, class: 'btn btn-secondary', data: resend_data, disabled: resend_disabled?
      small data=stimulus_target('countdown')

  .mt-3
    = button_to t('folio.users.email_login.cancel'), controller.main_app.user_email_login_path, method: :delete, class: 'btn btn-link f-users-email-login-waiting__cancel'
